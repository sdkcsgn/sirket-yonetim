generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sirket {
  id              Int             @id @default(autoincrement())
  ad              String
  kod             String          @unique
  aktif           Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bankalar        BankaHesabi[]
  cariler         Cari[]
  cekler          Cek[]
  faturalar       Fatura[]
  finansHesaplari FinansHesap[]
  giderler        Gider[]
  kasalar         Kasa[]
  krediler        Kredi[]
  stoklar         Stok[]
  odemeler        YaklasanOdeme[]
}

model Kullanici {
  id           Int          @id @default(autoincrement())
  kullaniciAdi String       @unique
  sifreHash    String
  adSoyad      String?
  rol          KullaniciRol @default(GORUNTULEME)
  aktif        Boolean      @default(true)
  sonGirisAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([rol])
  @@index([aktif])
}

model Cari {
  id                Int             @id @default(autoincrement())
  sirketId          Int
  atlasKodu         String?
  unvan             String
  tip               CariTipi
  yetkili           String?
  gsm               String?
  telefon           String?
  email             String?
  vergiNo           String?
  tcNo              String?
  vergiDairesi      String?
  adres             String?
  grupKodu          String?
  acilisBorc        Decimal         @default(0) @db.Decimal(18, 2)
  acilisAlacak      Decimal         @default(0) @db.Decimal(18, 2)
  notlar            String?
  aktif             Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sirket            Sirket          @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  hareketler        CariHareket[]
  cekler            Cek[]
  faturalar         Fatura[]
  finansHareketleri FinansHareket[]
  giderler          Gider[]
  odemeler          YaklasanOdeme[]
  stokHareketleri   StokHareket[]

  @@unique([sirketId, atlasKodu])
  @@index([sirketId, tip])
  @@index([unvan])
}

model CariHareket {
  id        Int         @id @default(autoincrement())
  cariId    Int
  tarih     DateTime
  tip       HareketTipi
  aciklama  String
  belgeNo   String?
  borc      Decimal     @default(0) @db.Decimal(18, 2)
  alacak    Decimal     @default(0) @db.Decimal(18, 2)
  createdAt DateTime    @default(now())
  islemTuru String?
  cari      Cari        @relation(fields: [cariId], references: [id], onDelete: Cascade)

  @@index([cariId, tarih])
}

model Fatura {
  id            Int              @id @default(autoincrement())
  sirketId      Int
  cariId        Int?
  tip           FaturaTipi
  faturaNo      String?
  tarih         DateTime
  vadeTarihi    DateTime?
  aciklama      String?
  araToplam     Decimal          @default(0) @db.Decimal(18, 2)
  kdvToplam     Decimal          @default(0) @db.Decimal(18, 2)
  genelToplam   Decimal          @default(0) @db.Decimal(18, 2)
  odendi        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cekId         Int?
  finansHesapId Int?
  odemeSekli    FaturaOdemeSekli @default(ACIK_HESAP)
  paraBirimi    ParaBirimi       @default(TRY)
  cari          Cari?            @relation(fields: [cariId], references: [id])
  cek           Cek?             @relation(fields: [cekId], references: [id])
  finansHesap   FinansHesap?     @relation(fields: [finansHesapId], references: [id])
  sirket        Sirket           @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  kalemler      FaturaKalemi[]

  @@index([sirketId, tip, tarih])
  @@index([cariId])
  @@index([finansHesapId])
  @@index([cekId])
  @@index([paraBirimi])
  @@index([odemeSekli])
}

model FaturaKalemi {
  id         Int     @id @default(autoincrement())
  faturaId   Int
  aciklama   String
  miktar     Decimal @default(1) @db.Decimal(18, 3)
  birim      String?
  birimFiyat Decimal @default(0) @db.Decimal(18, 2)
  kdvOrani   Decimal @default(0) @db.Decimal(5, 2)
  toplam     Decimal @default(0) @db.Decimal(18, 2)
  stokId     Int?
  fatura     Fatura  @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  stok       Stok?   @relation(fields: [stokId], references: [id])

  @@index([stokId])
}

model Gider {
  id            Int             @id @default(autoincrement())
  sirketId      Int
  cariId        Int?
  tip           GiderTipi
  tarih         DateTime        @default(now())
  aciklama      String
  belgeNo       String?
  tutar         Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())
  faturaNo      String?
  finansHesapId Int?
  updatedAt     DateTime        @updatedAt
  odemeSekli    GiderOdemeSekli
  cari          Cari?           @relation(fields: [cariId], references: [id])
  finansHesap   FinansHesap?    @relation(fields: [finansHesapId], references: [id])
  sirket        Sirket          @relation(fields: [sirketId], references: [id], onDelete: Cascade)

  @@index([sirketId, tarih])
  @@index([tip])
  @@index([odemeSekli])
  @@index([cariId])
  @@index([finansHesapId])
}

model BankaHesabi {
  id           Int            @id @default(autoincrement())
  sirketId     Int
  bankaAdi     String
  hesapAdi     String
  iban         String?
  hesapNo      String?
  mevcutBakiye Decimal        @default(0) @db.Decimal(18, 2)
  aktif        Boolean        @default(true)
  createdAt    DateTime       @default(now())
  hareketler   BankaHareket[]
  sirket       Sirket         @relation(fields: [sirketId], references: [id], onDelete: Cascade)
}

model BankaHareket {
  id        Int         @id @default(autoincrement())
  bankaId   Int
  tarih     DateTime
  tip       HareketTipi
  aciklama  String
  tutar     Decimal     @db.Decimal(18, 2)
  createdAt DateTime    @default(now())
  banka     BankaHesabi @relation(fields: [bankaId], references: [id], onDelete: Cascade)

  @@index([bankaId, tarih])
}

model Kasa {
  id           Int           @id @default(autoincrement())
  sirketId     Int
  ad           String
  mevcutBakiye Decimal       @default(0) @db.Decimal(18, 2)
  aktif        Boolean       @default(true)
  sirket       Sirket        @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  hareketler   KasaHareket[]
}

model KasaHareket {
  id        Int         @id @default(autoincrement())
  kasaId    Int
  tarih     DateTime
  tip       HareketTipi
  aciklama  String
  tutar     Decimal     @db.Decimal(18, 2)
  createdAt DateTime    @default(now())
  kasa      Kasa        @relation(fields: [kasaId], references: [id], onDelete: Cascade)

  @@index([kasaId, tarih])
}

model Cek {
  id              Int          @id @default(autoincrement())
  sirketId        Int
  cariId          Int?
  tip             CekTipi
  durum           CekDurumu    @default(PORTFOYDE)
  cekNo           String?
  banka           String?
  sube            String?
  hesapNo         String?
  kesideci        String?
  tutar           Decimal      @db.Decimal(18, 2)
  vadeTarihi      DateTime
  aciklama        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bankaHesabiId   Int?
  bankaIslendi    Boolean      @default(false)
  cariIslendi     Boolean      @default(false)
  ciroCariId      Int?
  ciroCariIslendi Boolean      @default(false)
  paraBirimi      ParaBirimi   @default(TRY)
  atlasAktarimRef String?
  atlasKayitNo    String?
  atlasRef        String?
  bankaHesabi     FinansHesap? @relation(fields: [bankaHesabiId], references: [id])
  cari            Cari?        @relation(fields: [cariId], references: [id])
  sirket          Sirket       @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  faturalar       Fatura[]

  @@index([sirketId, vadeTarihi])
  @@index([durum])
  @@index([cariId])
  @@index([bankaHesabiId])
  @@index([ciroCariId])
  @@index([atlasKayitNo])
  @@index([atlasRef])
  @@index([atlasAktarimRef])
}

model Stok {
  id              Int            @id @default(autoincrement())
  sirketId        Int
  kod             String
  ad              String
  kategori        String?
  birim           String
  mevcutMiktar    Decimal        @default(0) @db.Decimal(18, 3)
  alisFiyati      Decimal        @default(0) @db.Decimal(18, 2)
  satisFiyati     Decimal        @default(0) @db.Decimal(18, 2)
  minimumStok     Decimal        @default(0) @db.Decimal(18, 3)
  depoBolumu      String?
  aktif           Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  faturaKalemleri FaturaKalemi[]
  sirket          Sirket         @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  hareketler      StokHareket[]

  @@unique([sirketId, kod])
}

model StokHareket {
  id          Int      @id @default(autoincrement())
  stokId      Int
  cariId      Int?
  tarih       DateTime @default(now())
  giris       Decimal  @default(0) @db.Decimal(18, 3)
  cikis       Decimal  @default(0) @db.Decimal(18, 3)
  dara        Decimal  @default(0) @db.Decimal(18, 3)
  birimFiyat  Decimal  @default(0) @db.Decimal(18, 2)
  toplamTutar Decimal  @default(0) @db.Decimal(18, 2)
  odaNo       String?
  aciklama    String?
  belgeNo     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  stok        Stok     @relation(fields: [stokId], references: [id], onDelete: Cascade)
  cari        Cari?    @relation(fields: [cariId], references: [id], onDelete: SetNull)

  @@index([stokId, tarih])
  @@index([cariId])
}

model YaklasanOdeme {
  id         Int      @id @default(autoincrement())
  sirketId   Int
  cariId     Int?
  baslik     String
  aciklama   String?
  tutar      Decimal  @db.Decimal(18, 2)
  vadeTarihi DateTime
  odendi     Boolean  @default(false)
  createdAt  DateTime @default(now())
  cari       Cari?    @relation(fields: [cariId], references: [id])
  sirket     Sirket   @relation(fields: [sirketId], references: [id], onDelete: Cascade)

  @@index([sirketId, vadeTarihi])
}

model FinansHesap {
  id         Int               @id @default(autoincrement())
  sirketId   Int
  ad         String
  tip        FinansHesapTipi
  bankaAdi   String?
  iban       String?
  hesapNo    String?
  aktif      Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  paraBirimi ParaBirimi        @default(TRY)
  cekler     Cek[]
  faturalar  Fatura[]
  hareketler FinansHareket[]
  sirket     Sirket            @relation(fields: [sirketId], references: [id], onDelete: Cascade)
  giderler   Gider[]
  krediler   Kredi[]

  @@index([sirketId, tip])
  @@index([paraBirimi])
}

model FinansHareket {
  id            Int               @id @default(autoincrement())
  finansHesapId Int
  cariId        Int?
  tarih         DateTime          @default(now())
  tip           FinansHareketTipi
  tutar         Decimal           @db.Decimal(18, 2)
  aciklama      String
  belgeNo       String?
  transferRef   String?
  createdAt     DateTime          @default(now())
  cari          Cari?             @relation(fields: [cariId], references: [id])
  finansHesap   FinansHesap       @relation(fields: [finansHesapId], references: [id], onDelete: Cascade)

  @@index([finansHesapId, tarih])
  @@index([cariId])
  @@index([transferRef])
}

model Kredi {
  id                 Int          @id @default(autoincrement())
  sirketId           Int
  finansHesapId      Int?
  tip                KrediTipi
  durum              KrediDurumu  @default(AKTIF)
  paraBirimi         ParaBirimi   @default(TRY)
  ad                 String
  krediNo            String?
  anaPara            Decimal      @db.Decimal(18, 2)
  kalanBorc          Decimal      @db.Decimal(18, 2)
  faizOrani          Decimal?     @db.Decimal(8, 4)
  baslangicTarihi    DateTime
  vadeTarihi         DateTime?
  taksitSayisi       Int?
  odenenTaksitSayisi Int          @default(0)
  aylikTaksit        Decimal?     @db.Decimal(18, 2)
  sonrakiOdemeTarihi DateTime?
  krediLimiti        Decimal?     @db.Decimal(18, 2)
  kullanilanLimit    Decimal?     @db.Decimal(18, 2)
  aciklama           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  finansHesap        FinansHesap? @relation(fields: [finansHesapId], references: [id])
  sirket             Sirket       @relation(fields: [sirketId], references: [id], onDelete: Cascade)

  @@index([sirketId, tip])
  @@index([durum])
  @@index([vadeTarihi])
  @@index([sonrakiOdemeTarihi])
  @@index([finansHesapId])
}

enum CariTipi {
  DIGER
  MUSTERI
  URETICI
  SATICI
  UYE
  BANKA
  PERSONEL
  YARDIMCI_HESAP
  ALICI
}

enum FaturaTipi {
  SATIS
  ALIS
  ALINAN_HIZMET
  VERILEN_HIZMET
}

enum GiderTipi {
  ELEKTRIK
  SU
  PERSONEL
  NAKLIYE
  KIRA
  YAKIT
  BAKIM_ONARIM
  MUHASEBE
  KOMISYON
  VERGI_HARC
  TELEFON_INTERNET
  DIGER
  NOTER
  ODA_AIDAT
  DIGER_ARAC_GIDERLERI
  MARKET
  ORTULU_ODENEK
}

enum ParaBirimi {
  TRY
  USD
  EUR
  GBP
  RUB
}

enum FaturaOdemeSekli {
  NAKIT
  EFT_HAVALE
  KREDI_KARTI
  KENDI_CEKIMIZ
  CIRO_CEK
  ACIK_HESAP
}

enum GiderOdemeSekli {
  NAKIT
  EFT_HAVALE
  KREDI_KARTI
  ACIK_HESAP
}

enum CekTipi {
  ALINAN
  VERILEN
}

enum HareketTipi {
  BORC
  ALACAK
}

enum FinansHesapTipi {
  KASA
  BANKA
  KREDI_KARTI
}

enum FinansHareketTipi {
  GIRIS
  CIKIS
  TRANSFER_GIRIS
  TRANSFER_CIKIS
}

enum KrediTipi {
  TAKSITLI
  SPOT
  ROTATIF
}

enum KrediDurumu {
  AKTIF
  KAPANDI
}

enum KullaniciRol {
  ADMIN
  BEACH
  HAL
  GORUNTULEME
}

enum CekDurumu {
  PORTFOYDE
  BANKADA
  CIROLANDI
  TAHSIL_EDILDI
  ODENDI
  KARSILIKSIZ
  IPTAL
  IADE_EDILDI
  IADE_ALINDI
}